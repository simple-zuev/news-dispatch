{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simple-zuev.github.io/news-dispatch/schemas/content-intelligence-signal.schema.json",
  "title": "News Dispatch Content Intelligence Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "stream",
    "source_title",
    "source_url",
    "source_class",
    "language",
    "original_title",
    "ru_title",
    "ru_summary",
    "claim_type",
    "confirmation_level",
    "relevance_score",
    "impact_score",
    "freshness_score",
    "novelty_score",
    "why_selected",
    "why_it_matters",
    "affected_actors",
    "possible_effects",
    "uncertainties",
    "watch_next",
    "public_safety_notes"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 8},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "stream": {
      "type": "string",
      "enum": [
        "finance",
        "crypto-finance",
        "ai",
        "tech-hardware-software",
        "gear-style-edc",
        "moscow-city",
        "dj-audio-creative",
        "science-discovery"
      ]
    },
    "source_title": {"type": "string", "minLength": 2},
    "source_url": {"type": "string", "pattern": "^https?://"},
    "source_class": {
      "type": "string",
      "enum": ["official_source", "primary_source", "regulator", "research_media", "specialized_media", "public_media", "company_source"]
    },
    "language": {"type": "string", "minLength": 2},
    "original_title": {"type": "string", "minLength": 4},
    "ru_title": {"type": "string", "minLength": 4},
    "ru_summary": {"type": "string", "minLength": 20},
    "claim_type": {
      "type": "string",
      "enum": ["confirmed_fact", "source_reported_claim", "editorial_inference", "weak_signal", "rumor_unverified"]
    },
    "confirmation_level": {
      "type": "string",
      "enum": ["official", "primary_source", "multi_source", "source_reported", "weak_signal", "unknown"]
    },
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "impact_score": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness_score": {"type": "number", "minimum": 0, "maximum": 1},
    "novelty_score": {"type": "number", "minimum": 0, "maximum": 1},
    "why_selected": {"type": "string", "minLength": 20},
    "why_it_matters": {"type": "string", "minLength": 20},
    "affected_actors": {"type": "array", "items": {"type": "string", "minLength": 2}, "minItems": 1},
    "possible_effects": {"type": "array", "items": {"type": "string", "minLength": 6}, "minItems": 1},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 6}, "minItems": 1},
    "watch_next": {"type": "array", "items": {"type": "string", "minLength": 6}, "minItems": 1},
    "public_safety_notes": {"type": "array", "items": {"type": "string", "minLength": 6}, "minItems": 1}
  }
}
